{
  "version": "2",
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/bot",
      "dest": "api/bot.js"
    },
    {
      "src": "/api/users",
      "dest": "api/users.js"
    },
    {
      "src": "/manage_hd",
      "dest": "/manage_hd.html"
    },
    {
      "src": "/",
      "dest": "/manage_hd.html"
    }
  ]
}
